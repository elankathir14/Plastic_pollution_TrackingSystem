# ==============================================================
# AQUATRACE AI - MARINE PLASTIC POLLUTION MONITORING PLATFORM
# Environment Configuration Template
# ==============================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./marine_pollution.db
# For production PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://user:password@localhost:5432/marine_pollution_db

# Security & Secrets
SECRET_KEY=aquatrace_dev_secret_key_change_in_production_9f8d7c6b5a4
ADMIN_API_KEY=marine_admin_secure_key_2026

# Storage Paths
UPLOAD_DIR=./uploads
ANNOTATED_DIR=./uploads/annotated
MODEL_DIR=./ml/models

# Computer Vision Model Settings
YOLO_MODEL_NAME=yolov8n.pt
DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_IOU_THRESHOLD=0.45
MAX_IMAGE_UPLOAD_BYTES=15728640  # 15 MB

# Environmental Data Providers
# Open-Meteo Marine / Copernicus Marine
COPERNICUS_API_KEY=demo_copernicus_token_placeholder
COPERNICUS_USERNAME=demo_user
USE_ENVIRONMENTAL_FALLBACK=True

# Hotspot Intelligence Parameters
DBSCAN_EPS_KM=2.5
DBSCAN_MIN_SAMPLES=2
HOTSPOT_RECENCY_HALF_LIFE_DAYS=14
